{% extends "base.njk" %}
{% block titulo %}Acceso{% endblock %}
{% block contenido %}
<div class="d-flex justify-content-center py-4">
  <div class="card shadow-sm tarjeta-acceso">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <i class="bi bi-buildings text-primary icono-marca"></i>
        <h1 class="h4 mt-2 mb-1">Gestión de clientes</h1>
        <p class="text-secondary mb-0">Accede con tu cuenta</p>
      </div>
      {% if error %}
        <div class="alert alert-danger" role="alert">{{ error }}</div>
      {% endif %}
      <form method="post" action="/login">
        <div class="mb-3">
          <label for="email" class="form-label">Correo electrónico</label>
          <input type="email" class="form-control" id="email" name="email" value="{{ email }}"
                 autocomplete="username" required autofocus maxlength="254">
        </div>
        <div class="mb-4">
          <label for="clave" class="form-label">Contraseña</label>
          <input type="password" class="form-control" id="clave" name="clave"
                 autocomplete="current-password" required maxlength="200">
        </div>
        <button type="submit" class="btn btn-primary w-100">Entrar</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
