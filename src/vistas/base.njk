<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {# htmx: sin estilos ni evaluación de código incrustados, para cumplir la política de seguridad (CSP). #}
  <meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false}'>
  <title>{% block titulo %}{% endblock %} · Gestión de clientes</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/static/css/app.css">
</head>
<body class="bg-body-tertiary">
{% if usuario %}
  <nav class="navbar navbar-expand-md navbar-dark bg-dark">
    <div class="container-xxl">
      <a class="navbar-brand" href="/clientes"><i class="bi bi-buildings me-2"></i>Gestión de clientes</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
              aria-controls="menu" aria-expanded="false" aria-label="Mostrar u ocultar el menú">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav me-auto">
          <li class="nav-item">
            <a class="nav-link {% if seccion == 'clientes' %}active{% endif %}" href="/clientes"><i class="bi bi-people me-1"></i>Clientes</a>
          </li>
          <li class="nav-item">
            <a class="nav-link {% if seccion == 'ayuda' %}active{% endif %}" href="/ayuda"><i class="bi bi-question-circle me-1"></i>Ayuda</a>
          </li>
        </ul>
        <form method="post" action="/logout" class="d-flex align-items-center gap-3">
          <span class="navbar-text usuario-barra"><i class="bi bi-person-circle me-1"></i>{{ usuario.email }}</span>
          <button class="btn btn-outline-light btn-sm" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Salir</button>
        </form>
      </div>
    </div>
  </nav>
{% endif %}
  <main class="container-xxl py-4">
    {% if mensajeOk %}<div class="alert alert-success" role="status"><i class="bi bi-check-circle me-1"></i>{{ mensajeOk }}</div>{% endif %}
    {% if mensajeError %}<div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-octagon me-1"></i>{{ mensajeError }}</div>{% endif %}
    {% block contenido %}{% endblock %}
  </main>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/vendor/htmx/htmx.min.js"></script>
  <script src="/static/js/app.js"></script>
</body>
</html>
